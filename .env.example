# Dev-server proxy target for the MCP host. Only the demo's Vite dev server reads this;
# the published library never makes a request.
VITE_MCP_API_PROXY_TARGET=https://ncpapidev.linkbrain.ai.kr

# linkbrain access token and workspace context for the knowledge-graph demo. Copy this
# file to .env and fill them in locally — .env is gitignored and must stay that way.
VITE_MCP_TOKEN=
VITE_MCP_ORG_ID=
VITE_MCP_TEAM_ID=
VITE_MCP_WORKSPACE_ID=
VITE_MCP_CONTEXT_TOKEN=
