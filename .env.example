# Dev-server targets. Only the demo's Vite dev server reads these; the published library
# never makes a request of its own.
VITE_DEV_API_PROXY_TARGET=https://ncpapidev.linkbrain.ai.kr
VITE_MCP_API_PROXY_TARGET=https://ncpapidev.linkbrain.ai.kr

# Credentials for the knowledge-graph demo. No VITE_ prefix, so Vite keeps them out of
# the client bundle: the dev server signs in and attaches the headers itself.
# Put the real values in .env.local, which is gitignored.
MCP_DEMO_EMAIL=
MCP_DEMO_PASSWORD=
# Optional. Unset picks the account's first organization.
MCP_DEMO_ORG_UUID=
